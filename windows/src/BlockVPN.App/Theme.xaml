<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="BgBrush" Color="#0F0F12"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#17171C"/>
  <SolidColorBrush x:Key="CardBrush" Color="#1C1C23"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#39FF14"/>
  <SolidColorBrush x:Key="Accent2Brush" Color="#FFD600"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2"/>
  <SolidColorBrush x:Key="DimBrush" Color="#9A9AA5"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#FF3B3B"/>
  <SolidColorBrush x:Key="NeutralBrush" Color="#8A8A95"/>
  <Color x:Key="AccentColor">#39FF14</Color>
  <Color x:Key="Accent2Color">#FFD600</Color>

  <Style x:Key="StreetTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Black"/>
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <Style x:Key="StreetH2" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Black"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <Style x:Key="DimText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <Style x:Key="DangerText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="StatLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="StatValue" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontFamily" Value="Segoe UI Black"/>
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.14"/>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="StreetButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="#0F0F12"/>
    <Setter Property="FontFamily" Value="Segoe UI Black"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="Padding" Value="40,12"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="26" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.3"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Большая кнопка подключения: неоновая подсветка, плавное увеличение при наведении -->
  <Style x:Key="ConnectButton" TargetType="Button" BasedOn="{StaticResource StreetButton}">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="Padding" Value="60,16"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="30" Padding="{TemplateBinding Padding}"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
              <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.05" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.05" Duration="0:0:0.18">
                      <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Effect.Opacity" To="0.85" Duration="0:0:0.18"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Effect.Opacity" To="0.55" Duration="0:0:0.22"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.3"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI Black"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="18,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource DimBrush}" BorderThickness="2" CornerRadius="18" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="bd" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.3"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NavRadio" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="14,10" Margin="6,2">
            <TextBlock x:Name="txt" Text="{TemplateBinding Content}" FontFamily="Segoe UI Black" FontSize="15" Foreground="{DynamicResource DimBrush}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#26262E"/>
              <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="bd" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="StreetTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="#101014"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="#33333D"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
  </Style>

  <Style x:Key="StreetCheck" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Margin" Value="0,6"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

</ResourceDictionary>
