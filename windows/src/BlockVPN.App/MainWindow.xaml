<Window x:Class="BlockVPN.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlockVPN" Height="680" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI"
        ResizeMode="CanResize">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="215"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,22,10,26">
          <TextBlock Text="BLOCK" FontFamily="Segoe UI Black" FontSize="32" Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock Text="VPN // УЛИЦЫ" FontFamily="Segoe UI Black" FontSize="13" Foreground="{DynamicResource DimBrush}" Margin="2,0,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,16">
          <TextBlock x:Name="VersionText" Style="{StaticResource DimText}" FontSize="11"/>
        </StackPanel>

        <StackPanel Margin="8,0">
          <RadioButton x:Name="NavMain" Content="ГЛАВНАЯ" Style="{StaticResource NavRadio}" GroupName="nav" IsChecked="True" Click="Nav_Click"/>
          <RadioButton x:Name="NavServers" Content="СЕРВЕРА" Style="{StaticResource NavRadio}" GroupName="nav" Click="Nav_Click"/>
          <RadioButton x:Name="NavTag" Content="МОЙ ТЕГ" Style="{StaticResource NavRadio}" GroupName="nav" Click="Nav_Click"/>
          <RadioButton x:Name="NavSettings" Content="НАСТРОЙКИ" Style="{StaticResource NavRadio}" GroupName="nav" Click="Nav_Click"/>
          <RadioButton x:Name="NavHelp" Content="ПОМОЩЬ" Style="{StaticResource NavRadio}" GroupName="nav" Click="Nav_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ContentControl x:Name="ContentHost" Grid.Column="1"/>
  </Grid>
</Window>
