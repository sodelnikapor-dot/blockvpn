<Window x:Class="BlockVPN.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlockVPN" Height="680" Width="1000"
        Icon="icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI"
        ResizeMode="CanResize">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="215"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Фон темы: градиент + неоновые пятна в цветах сцены (чистый декор) -->
    <Border Grid.ColumnSpan="2" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
          <GradientStop x:Name="BgStop1" Color="#0B0B10" Offset="0"/>
          <GradientStop x:Name="BgStop2" Color="#050507" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Ellipse x:Name="BgGlow1" Grid.ColumnSpan="2" Width="460" Height="460"
             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-140,-160,0,0"
             IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop x:Name="GlowStop1" Color="#1439FF14" Offset="0"/>
          <GradientStop Color="#0039FF14" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
      <Ellipse.Effect>
        <BlurEffect Radius="70"/>
      </Ellipse.Effect>
    </Ellipse>
    <Ellipse x:Name="BgGlow2" Grid.ColumnSpan="2" Width="520" Height="520"
             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-180"
             IsHitTestVisible="False">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop x:Name="GlowStop2" Color="#10FFD600" Offset="0"/>
          <GradientStop Color="#00FFD600" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
      <Ellipse.Effect>
        <BlurEffect Radius="80"/>
      </Ellipse.Effect>
    </Ellipse>

    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,22,10,26">
          <TextBlock Text="BLOCK" FontFamily="Segoe UI Black" FontSize="32" Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock Text="VPN // УЛИЦЫ" FontFamily="Segoe UI Black" FontSize="13" Foreground="{DynamicResource DimBrush}" Margin="2,0,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,16">
          <TextBlock x:Name="VersionText" Style="{StaticResource DimText}" FontSize="11"/>
        </StackPanel>

        <StackPanel Margin="8,0">
          <RadioButton x:Name="NavMain" Content="ГЛАВНАЯ" Style="{StaticResource NavRadio}" GroupName="nav" IsChecked="True" Click="Nav_Click"/>
          <RadioButton x:Name="NavServers" Content="СЕРВЕРА" Style="{StaticResource NavRadio}" GroupName="nav" Click="Nav_Click"/>
          <RadioButton x:Name="NavTag" Content="МОЙ ТЕГ" Style="{StaticResource NavRadio}" GroupName="nav" Click="Nav_Click"/>
          <RadioButton x:Name="NavSettings" Content="НАСТРОЙКИ" Style="{StaticResource NavRadio}" GroupName="nav" Click="Nav_Click"/>
          <RadioButton x:Name="NavHelp" Content="ПОМОЩЬ" Style="{StaticResource NavRadio}" GroupName="nav" Click="Nav_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ContentControl x:Name="ContentHost" Grid.Column="1"/>
  </Grid>
</Window>
