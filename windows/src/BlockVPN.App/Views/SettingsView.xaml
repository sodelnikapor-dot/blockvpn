<UserControl x:Class="BlockVPN.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,20,28,16">
      <TextBlock Text="НАСТРОЙКИ" Style="{StaticResource StreetTitle}" Margin="0,0,0,16"/>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="ПАЛИТРА" Style="{StaticResource StatLabel}" Margin="0,0,0,8"/>
          <ComboBox x:Name="ThemeCombo" Width="240" HorizontalAlignment="Left" SelectionChanged="ThemeCombo_SelectionChanged"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="ОФОРМЛЕНИЕ" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
          <CheckBox x:Name="AnimationsCheck" Style="{StaticResource StreetCheck}" Content="Анимации (пульс и свечение)"
                    Checked="Anim_Changed" Unchecked="Anim_Changed"/>
          <CheckBox x:Name="DecorCheck" Style="{StaticResource StreetCheck}" Content="Показывать декор (тег, стикеры)"
                    Checked="Decor_Changed" Unchecked="Decor_Changed"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="ПОВЕДЕНИЕ" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
          <CheckBox x:Name="AutoStartCheck" Style="{StaticResource StreetCheck}" Content="Запускать BlockVPN при входе в Windows (появится окно UAC)"
                    Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
          <CheckBox x:Name="AutoConnectCheck" Style="{StaticResource StreetCheck}" Content="Автоподключаться к выбранному серверу при старте"
                    Checked="AutoConnect_Changed" Unchecked="AutoConnect_Changed"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="ЗАЩИТА ОТ УТЕЧЕК (KILL SWITCH)" Style="{StaticResource StatLabel}" Margin="0,0,0,6"/>
          <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                     Text="В Windows нет единого системного переключателя «блокировать всё без VPN», как на Android. Честный вариант прямо сейчас: настройки брандмауэра Windows — можно заблокировать исходящие соединения для программ, которым нельзя ходить мимо туннеля. Полный kill switch запланирован на следующий этап (правила брандмауэра будут настраиваться автоматически)."/>
          <Button Content="ОТКРЫТЬ БРАНДМАУЭР WINDOWS" Style="{StaticResource GhostButton}" Margin="0,10,0,0" Click="Firewall_Click"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="ПРИВАТНОСТЬ" Style="{StaticResource StatLabel}" Margin="0,0,0,6"/>
          <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                     Text="BlockVPN не собирает историю посещений, не анализирует трафик и не отправляет данные третьим сторонам. Локально хранятся: конфиги серверов (шифруются DPAPI), настройки вида и счётчики подключений. Журнал туннеля — только на этом компьютере, только для диагностики."/>
        </StackPanel>
      </Border>

      <!-- ЕЩЁ: меню как в мобильных VPN-клиентах, в нашей стилистике -->
      <TextBlock Text="ЕЩЁ" Style="{StaticResource StatLabel}" Margin="0,10,0,8"/>

      <Button Style="{StaticResource MenuRow}" Click="Contact_Click">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="📮" FontSize="17" Margin="0,0,12,0"/>
          <TextBlock Grid.Column="1" Text="Связаться с нами"/>
          <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{DynamicResource DimBrush}"/>
        </Grid>
      </Button>

      <Button Style="{StaticResource MenuRow}" Click="Telegram_Click">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="📢" FontSize="17" Margin="0,0,12,0"/>
          <TextBlock Grid.Column="1" Text="Наш канал в Telegram"/>
          <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{DynamicResource DimBrush}"/>
        </Grid>
      </Button>
      <TextBlock x:Name="TelegramNote" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="4,0,0,8"
                 Visibility="Collapsed"/>

      <Button Style="{StaticResource MenuRow}" Click="Share_Click">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="🔗" FontSize="17" Margin="0,0,12,0"/>
          <TextBlock Grid.Column="1" Text="Поделиться приложением"/>
          <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{DynamicResource DimBrush}"/>
        </Grid>
      </Button>
      <TextBlock x:Name="ShareNote" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="4,0,0,8"
                 Visibility="Collapsed"/>

      <Button Style="{StaticResource MenuRow}" Click="Terms_Click">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="📄" FontSize="17" Margin="0,0,12,0"/>
          <TextBlock Grid.Column="1" Text="Условия использования"/>
          <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{DynamicResource DimBrush}"/>
        </Grid>
      </Button>
      <Border x:Name="TermsPanel" Visibility="Collapsed" Background="#101014" CornerRadius="10"
              Padding="12,10" Margin="0,0,0,8">
        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                   Text="BlockVPN — бесплатный open-source клиент WireGuard. Приложение предоставляется «как есть», без гарантий бесперебойной работы. VPN не делает тебя полностью анонимным: сервер, которому ты доверяешь, видит твой IP и трафик. Не используй приложение для незаконных действий. Исходный код: github.com/sodelnikapor-dot/blockvpn"/>
      </Border>

      <Button Style="{StaticResource MenuRow}" Click="Privacy_Click">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="✅" FontSize="17" Margin="0,0,12,0"/>
          <TextBlock Grid.Column="1" Text="Политика конфиденциальности"/>
          <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{DynamicResource DimBrush}"/>
        </Grid>
      </Button>
      <Border x:Name="PrivacyPanel" Visibility="Collapsed" Background="#101014" CornerRadius="10"
              Padding="12,10" Margin="0,0,0,8">
        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                   Text="Мы ничего не собираем: ни историю посещений, ни содержимое трафика, ни аналитику. На компьютере хранятся только твои конфиги серверов (шифрование DPAPI), настройки вида и счётчики подключений. Журнал туннеля остаётся на этом компьютере и нужен только для диагностики. Данные не передаются третьим сторонам."/>
      </Border>

      <Button Style="{StaticResource MenuRow}" Click="NetTool_Click">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="🧰" FontSize="17" Margin="0,0,12,0"/>
          <TextBlock Grid.Column="1" Text="Сетевой инструмент"/>
          <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{DynamicResource DimBrush}"/>
        </Grid>
      </Button>
      <Border x:Name="NetPanel" Visibility="Collapsed" Background="#101014" CornerRadius="10"
              Padding="12,10" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                     Text="Быстрая проверка: резолвится ли DNS и виден ли адаптер VPN."/>
          <Button Content="ПРОВЕРИТЬ" Style="{StaticResource GhostButton}" Margin="0,8,0,0" Click="NetCheck_Click"/>
          <TextBlock x:Name="NetResult" Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
