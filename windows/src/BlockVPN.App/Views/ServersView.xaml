<UserControl x:Class="BlockVPN.App.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28,20,28,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="СЕРВЕРА" Style="{StaticResource StreetTitle}"/>
      <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource StreetButton}"
              Content="+ ДОБАВИТЬ" FontSize="14" Padding="22,9" Click="AddButton_Click"/>
    </DockPanel>

    <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource DimText}" TextWrapping="Wrap"
               Text="Пока нет ни одного сервера. Нажми «+ Добавить» и вставь WireGuard-конфиг (файл .conf или текст от администратора сервера). Где взять конфиг — см. вкладку «Помощь»."
               VerticalAlignment="Top"/>

    <ListBox x:Name="ProfilesList" Grid.Row="1" Background="Transparent" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectionChanged="ProfilesList_SelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14" Margin="0,4">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Black" FontSize="17" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="RegionText" Text="{Binding Region}" Style="{StaticResource DimText}" Margin="0,3,0,0"/>
                <TextBlock x:Name="EndpointText" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" Content="УДАЛИТЬ" Style="{StaticResource GhostButton}" Click="DeleteButton_Click"
                      VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
