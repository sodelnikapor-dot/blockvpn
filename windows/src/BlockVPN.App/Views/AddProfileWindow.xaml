<Window x:Class="BlockVPN.App.Views.AddProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить сервер" Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" FontFamily="Segoe UI">
  <StackPanel Margin="20">
    <TextBlock Text="НОВЫЙ СЕРВЕР" Style="{StaticResource StreetH2}" Margin="0,0,0,12"/>
    <TextBlock Text="Название" Style="{StaticResource DimText}"/>
    <TextBox x:Name="NameBox" Style="{StaticResource StreetTextBox}" MaxLength="40" Margin="0,4,0,10"/>
    <TextBlock Text="Регион / страна (например: Нидерланды)" Style="{StaticResource DimText}"/>
    <TextBox x:Name="RegionBox" Style="{StaticResource StreetTextBox}" MaxLength="40" Margin="0,4,0,10"/>
    <TextBlock Text="WireGuard-конфиг ([Interface]…[Peer]…)" Style="{StaticResource DimText}"/>
    <TextBox x:Name="ConfigBox" Style="{StaticResource StreetTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
             Height="180" Margin="0,4,0,8" FontFamily="Consolas"/>
    <TextBlock x:Name="ErrorText" Style="{StaticResource DangerText}" Visibility="Collapsed" Margin="0,0,0,8"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="ОТМЕНА" Style="{StaticResource GhostButton}" IsCancel="True"/>
      <Button Content="СОХРАНИТЬ" Style="{StaticResource StreetButton}" Margin="10,0,0,0" Click="Save_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
